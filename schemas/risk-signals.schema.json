{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/popuchoco/asustor-nas-cli/blob/main/schemas/risk-signals.schema.json",
  "title": "ASUSTOR ADM risk signals",
  "type": "object",
  "required": ["schema_version", "report_type", "host", "host_id", "ssh_port", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "risk-signals"},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "host": {"type": ["string", "null"]},
    "host_id": {"type": ["string", "null"]},
    "ssh_port": {"type": ["integer", "null"]},
    "summary": {
      "type": "object",
      "required": ["state", "coverage", "risk_signals", "recommended_exit_code", "raid", "smart", "temperature"],
      "properties": {
        "state": {"enum": ["observed", "attention", "unknown"]},
        "coverage": {"enum": ["complete", "partial", "unavailable"]},
        "recommended_exit_code": {"enum": [0, 1, 2]},
        "risk_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "severity", "message"],
            "properties": {
              "code": {"enum": ["raid_degraded", "smart_failed", "temperature_high"]},
              "severity": {"enum": ["warning", "critical"]},
              "message": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "raid": {
          "type": "object",
          "required": ["state", "coverage", "degraded_arrays"],
          "properties": {
            "state": {"enum": ["degraded", "unknown", "observed", "no_arrays"]},
            "coverage": {"enum": ["complete", "partial", "unavailable"]},
            "degraded_arrays": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "smart": {
          "type": "object",
          "required": ["coverage", "state", "failed_count", "failed_devices", "unknown_count", "unknown_devices"],
          "properties": {
            "coverage": {"enum": ["complete", "partial", "unavailable"]},
            "state": {"enum": ["passed", "failed", "unknown"]},
            "failed_count": {"type": "integer", "minimum": 0},
            "failed_devices": {"type": "array", "items": {"type": "string", "pattern": "^(sd[a-z]+|nvme[0-9]+n[0-9]+)$"}},
            "unknown_count": {"type": "integer", "minimum": 0},
            "unknown_devices": {"type": "array", "items": {"type": "string", "pattern": "^(sd[a-z]+|nvme[0-9]+n[0-9]+)$"}}
          },
          "additionalProperties": false
        },
        "temperature": {
          "type": "object",
          "required": ["coverage", "warning_threshold_celsius", "high_count", "high_sensors"],
          "properties": {
            "coverage": {"enum": ["complete", "partial", "unavailable"]},
            "warning_threshold_celsius": {"type": "number", "minimum": 1, "maximum": 150},
            "high_count": {"type": "integer", "minimum": 0},
            "high_sensors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sensor", "celsius"],
                "properties": {
                  "sensor": {"type": "string", "pattern": "^thermal_zone[0-9]+$"},
                  "celsius": {"type": "number"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "observations": {
          "type": "object",
          "required": ["services", "ups", "connections"],
          "properties": {
            "services": {"$ref": "#/$defs/services"},
            "ups": {"$ref": "#/$defs/ups"},
            "connections": {"$ref": "#/$defs/connections"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "services": {
      "type": "object",
      "required": ["coverage", "processes", "note"],
      "properties": {
        "coverage": {"enum": ["complete", "partial", "unavailable"]},
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "process_count"],
            "properties": {
              "name": {"enum": ["sshd", "httpd", "nginx", "smbd", "nmbd", "afpd", "avahi-daemon", "crond", "mysqld", "minidlna", "upsd", "upsmon"]},
              "process_count": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ups": {
      "type": "object",
      "required": ["coverage", "source", "device_count", "devices", "note"],
      "properties": {
        "coverage": {"enum": ["complete", "partial", "unavailable"]},
        "source": {"enum": ["nut", null]},
        "device_count": {"type": ["integer", "null"], "minimum": 0},
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "status", "battery_charge_percent"],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "status": {"enum": ["online", "on_battery", "low_battery", "charging", "discharging", "other", "unavailable"]},
              "battery_charge_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
            },
            "additionalProperties": false
          }
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "connections": {
      "type": "object",
      "required": ["coverage", "protocol", "ipv4", "ipv6", "note"],
      "properties": {
        "coverage": {"enum": ["complete", "partial", "unavailable"]},
        "protocol": {"const": "TCP"},
        "ipv4": {"$ref": "#/$defs/tcpCounts"},
        "ipv6": {"$ref": "#/$defs/tcpCounts"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "tcpCounts": {
      "type": ["object", "null"],
      "required": ["total", "established", "listening"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "established": {"type": "integer", "minimum": 0},
        "listening": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
