{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/popuchoco/asustor-nas-cli/blob/main/schemas/service-observations.schema.json",
  "title": "ASUSTOR ADM allowlisted service process observations",
  "type": "object",
  "required": ["schema_version", "report_type", "generated_at", "host", "host_id", "ssh_port", "coverage", "processes", "note"],
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "service-observations"},
    "generated_at": {"type": "string", "format": "date-time"},
    "host": {"const": "NAS"},
    "host_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "coverage": {"enum": ["complete", "partial", "unavailable"]},
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "process_count"],
        "properties": {
          "name": {"enum": ["sshd", "httpd", "nginx", "smbd", "nmbd", "afpd", "avahi-daemon", "crond", "mysqld", "minidlna", "upsd", "upsmon"]},
          "process_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
